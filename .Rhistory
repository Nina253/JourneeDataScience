)
########################################################
# Grille des k
########################################################
grid_k <- expand.grid(k = 1:30)
########################################################
# Entraînement
#
# metric n'est PAS spécifié :
# on sélectionnera nous-mêmes le meilleur k ensuite.
########################################################
knn_fit <- train(
DIFF ~ .,
data = farms,
method = "knn",
trControl = ctrl,
preProcess = c("center", "scale"),
tuneGrid = grid_k
)
########################################################
# Résultats CV
########################################################
results <- knn_fit$results
cat("\nRésultats de la validation croisée :\n")
print(results)
########################################################
# Sélection du meilleur k
#
# 1. Sensitivity classe 0 : maximum
# 2. Accuracy             : maximum
# 3. Specificity          : maximum
########################################################
results_sorted <- results[
order(
-results$Sensitivity_0,
-results$Accuracy,
-results$Specificity
),
]
best_k <- results_sorted$k[1]
cat("\n========================================\n")
cat("Meilleur k :", best_k, "\n")
cat("========================================\n")
cat(
"Sensitivity classe 0 :",
round(results_sorted$Sensitivity_0[1], 4),
"\n"
)
cat(
"Accuracy             :",
round(results_sorted$Accuracy[1], 4),
"\n"
)
cat(
"Specificity          :",
round(results_sorted$Specificity[1], 4),
"\n"
)
########################################################
# Tableau des meilleurs k
########################################################
cat("\nClassement des k :\n")
print(
results_sorted[
,
c("k", "Sensitivity_0", "Accuracy", "Specificity")
]
)
########################################################
# Visualisation Sensitivity classe 0
########################################################
plot(
results$k,
results$Sensitivity_0,
type = "b",
xlab = "k",
ylab = "Sensitivity classe 0",
main = "Sensitivity de la classe 0 selon k"
)
abline(
h = results_sorted$Sensitivity_0[1],
lty = 2
)
########################################################
# Modèle final avec le meilleur k
########################################################
knn_final <- train(
DIFF ~ .,
data = farms,
method = "knn",
trControl = trainControl(method = "none"),
preProcess = c("center", "scale"),
tuneGrid = data.frame(k = best_k)
)
########################################################
# Evaluation sur le train
########################################################
pred <- predict(
knn_final,
newdata = farms
)
cat(
"\nMatrice de confusion sur le train",
"(k =", best_k, ") :\n"
)
cm <- confusionMatrix(
pred,
farms$DIFF,
positive = "Classe0"
)
print(cm)
cat(
"\nSensitivity classe 0 :",
round(cm$byClass["Sensitivity"], 4),
"\n"
)
cat(
"Specificity           :",
round(cm$byClass["Specificity"], 4),
"\n"
)
cat(
"Accuracy              :",
round(cm$overall["Accuracy"], 4),
"\n"
)
# ============================================================
# TEST : préparation, prédiction de DIFF et export
# ============================================================
farms_test <- read.csv("data/farms_test.csv")
########################################################
# TOF :
# mêmes niveaux que dans le train
########################################################
farms_test$TOF <- factor(
farms_test$TOF,
levels = levels(farms$TOF)
)
# Vérification du type de TOF
print(class(farms_test$TOF))
########################################################
# Prédiction de la classe DIFF
########################################################
pred_test <- predict(
knn_final,
newdata = farms_test,
type = "raw"
)
########################################################
# Probabilités pour chaque classe
########################################################
prob_test <- predict(
knn_final,
newdata = farms_test,
type = "prob"
)
########################################################
# Ajouter les résultats au fichier test
########################################################
farms_test_result <- farms_test
farms_test_result$DIFF_pred <- pred_test
farms_test_result$Prob_DIFF_0 <- prob_test[, "Classe0"]
farms_test_result$Prob_DIFF_1 <- prob_test[, "Classe1"]
# Afficher les premières prédictions
head(farms_test_result)
########################################################
# FICHIER FINAL
#
# ID = numéro de ligne du fichier test
# DIFF = 0 ou 1
########################################################
resultat_final <- data.frame(
ID = 1:nrow(farms_test),
DIFF = ifelse(
pred_test == "Classe0",
0,
1
)
)
########################################################
# Sauvegarder
########################################################
write.csv(
resultat_final,
"data/farms_test_predictions.csv",
row.names = FALSE
)
# Vérification
cat("\nFichier final :\n")
head(resultat_final)
# ============================================================
# DIAGNOSTIC COMPLET
# ROC / AUC / F1 / Balanced Accuracy
# TRAIN VS VALIDATION CROISEE
# ============================================================
########################################################
# 1. Récupérer les prédictions CV du meilleur k
########################################################
oof <- knn_fit$pred[
knn_fit$pred$k == best_k,
]
########################################################
# Vérifier les colonnes disponibles
########################################################
cat("\nColonnes disponibles dans oof :\n")
print(names(oof))
########################################################
# 2. Facteurs
########################################################
oof$obs <- factor(
oof$obs,
levels = c("Classe0", "Classe1")
)
oof$pred <- factor(
oof$pred,
levels = c("Classe0", "Classe1")
)
########################################################
# 3. Matrice de confusion - VALIDATION CROISEE
########################################################
cm_cv <- confusionMatrix(
oof$pred,
oof$obs,
positive = "Classe0"
)
cat("\n========================================\n")
cat("MATRICE DE CONFUSION - VALIDATION CROISEE\n")
cat("========================================\n")
print(cm_cv)
########################################################
# 4. Métriques CV
########################################################
sens_cv <- unname(
cm_cv$byClass["Sensitivity"]
)
spec_cv <- unname(
cm_cv$byClass["Specificity"]
)
acc_cv <- unname(
cm_cv$overall["Accuracy"]
)
balacc_cv <- unname(
cm_cv$byClass["Balanced Accuracy"]
)
precision_cv <- unname(
cm_cv$byClass["Pos Pred Value"]
)
# Calcul manuel du F1
f1_cv <- 2 * (
precision_cv * sens_cv
) / (
precision_cv + sens_cv
)
cat("\n========================================\n")
cat("METRIQUES VALIDATION CROISEE\n")
cat("========================================\n")
cat(
"Sensitivity classe 0 :",
round(sens_cv, 4),
"\n"
)
cat(
"Specificity           :",
round(spec_cv, 4),
"\n"
)
cat(
"Accuracy              :",
round(acc_cv, 4),
"\n"
)
cat(
"Balanced Accuracy     :",
round(balacc_cv, 4),
"\n"
)
cat(
"Precision classe 0    :",
round(precision_cv, 4),
"\n"
)
cat(
"F1-score classe 0     :",
round(f1_cv, 4),
"\n"
)
########################################################
# 5. Probabilité de la classe 0
########################################################
prob_0 <- oof[, "Classe0"]
########################################################
# 6. ROC / AUC
########################################################
roc_cv <- roc(
response = oof$obs,
predictor = prob_0,
levels = c("Classe1", "Classe0"),
direction = "<"
)
auc_cv <- auc(roc_cv)
cat("\n========================================\n")
cat("ROC / AUC\n")
cat("========================================\n")
cat(
"AUC validation croisée :",
round(as.numeric(auc_cv), 4),
"\n"
)
########################################################
# 7. Courbe ROC
########################################################
plot(
roc_cv,
main = paste(
"ROC - Validation croisée - k =",
best_k
),
print.auc = TRUE
)
abline(
a = 0,
b = 1,
lty = 2
)
########################################################
# 8. Performance sur le TRAIN
########################################################
pred_train <- predict(
knn_final,
newdata = farms,
type = "raw"
)
prob_train <- predict(
knn_final,
newdata = farms,
type = "prob"
)
cm_train <- confusionMatrix(
pred_train,
farms$DIFF,
positive = "Classe0"
)
sens_train <- unname(
cm_train$byClass["Sensitivity"]
)
spec_train <- unname(
cm_train$byClass["Specificity"]
)
acc_train <- unname(
cm_train$overall["Accuracy"]
)
balacc_train <- unname(
cm_train$byClass["Balanced Accuracy"]
)
precision_train <- unname(
cm_train$byClass["Pos Pred Value"]
)
# Calcul manuel du F1
f1_train <- 2 * (
precision_train * sens_train
) / (
precision_train + sens_train
)
########################################################
# 9. ROC / AUC TRAIN
########################################################
roc_train <- roc(
response = farms$DIFF,
predictor = prob_train[, "Classe0"],
levels = c("Classe1", "Classe0"),
direction = "<"
)
auc_train <- auc(roc_train)
########################################################
# 10. Comparaison TRAIN vs CV
########################################################
comparaison <- data.frame(
Metrique = c(
"Sensitivity classe 0",
"Specificity",
"Accuracy",
"Balanced Accuracy",
"Precision classe 0",
"F1-score classe 0",
"AUC"
),
Train = c(
sens_train,
spec_train,
acc_train,
balacc_train,
precision_train,
f1_train,
as.numeric(auc_train)
),
Validation_Croisee = c(
sens_cv,
spec_cv,
acc_cv,
balacc_cv,
precision_cv,
f1_cv,
as.numeric(auc_cv)
)
)
########################################################
# 11. Ecart TRAIN - CV
########################################################
comparaison$Ecart_Train_CV <- (
comparaison$Train -
comparaison$Validation_Croisee
)
########################################################
# Affichage
########################################################
cat("\n========================================\n")
cat("TRAIN VS VALIDATION CROISEE\n")
cat("========================================\n")
print(comparaison)
########################################################
# 12. ROC Train vs CV
########################################################
plot(
roc_train,
main = "ROC : Train vs Validation croisée"
)
lines(
roc_cv,
lty = 2
)
abline(
a = 0,
b = 1,
lty = 2
)
legend(
"bottomright",
legend = c(
paste0(
"Train - AUC = ",
round(as.numeric(auc_train), 3)
),
paste0(
"Validation - AUC = ",
round(as.numeric(auc_cv), 3)
)
),
lty = c(1, 2)
)
########################################################
# 13. Résumé final
########################################################
cat("\n========================================\n")
cat("RESUME FINAL\n")
cat("========================================\n")
cat(
"Meilleur k :",
best_k,
"\n\n"
)
cat(
"Sensitivity 0 - CV :",
round(sens_cv, 4),
"\n"
)
cat(
"Accuracy - CV      :",
round(acc_cv, 4),
"\n"
)
cat(
"Specificity - CV   :",
round(spec_cv, 4),
"\n"
)
cat(
"Balanced Accuracy  :",
round(balacc_cv, 4),
"\n"
)
cat(
"Precision 0 - CV   :",
round(precision_cv, 4),
"\n"
)
cat(
"F1-score 0 - CV    :",
round(f1_cv, 4),
"\n"
)
cat(
"AUC - CV           :",
round(as.numeric(auc_cv), 4),
"\n\n"
)
cat(
"Ecart Accuracy Train-CV :",
round(
acc_train - acc_cv,
4
),
"\n"
)
cat(
"Ecart AUC Train-CV      :",
round(
as.numeric(auc_train) -
as.numeric(auc_cv),
4
),
"\n"
)
